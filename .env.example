# Keystatic GitHub mode. Generated by the Keystatic setup wizard (see README),
# then copied into Netlify: Site configuration > Environment variables.
# Never commit real values.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Analytics (Cloudflare Web Analytics token). Leave empty to disable; nothing
# is loaded or tracked without it. Set it in Netlify, not locally.
CLOUDFLARE_ANALYTICS_TOKEN=

# Local only: set to "github" to run the GitHub App setup wizard from `pnpm dev`.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
